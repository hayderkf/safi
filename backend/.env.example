# انسخه إلى .env وعدّل حسب بيئتك
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.2
MAX_REPAIRS=2
LLM_TIMEOUT=300

# الشبكة (منافذ Safi)
API_PORT=8601
WEB_ORIGIN=http://localhost:3601

# قاعدة البيانات (عدّل المستخدم/كلمة المرور إن لزم)
DATABASE_URL=postgresql+asyncpg://localhost:5432/safi

# المصادقة (JWT) — للإنتاج عيّن سرّاً قويّاً عشوائياً
JWT_SECRET=
JWT_EXPIRE_MINUTES=720
# حساب المسؤول الأولي (غيّره فوراً في الإنتاج)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
