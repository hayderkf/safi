          "ar": "اسم المشروع",
          "en": "Project Name"
        },
        "isRequired": true
      },
      {
        "id": "governorate",
        "type": "textField",
        "labelTranslations": {
          "ar": "المحافظة",
          "en": "Governorate"
        },
        "isRequired": true
      },
      {
        "id": "start_date",
        "type": "dateField",
        "labelTranslations": {
          "ar": "تاريخ البدء",
          "en": "Start Date"
        },
        "isRequired": true
      }
    ]
  },
  {
    "id": "step_indicators",
    "type": "groupField",
    "layout": "step",
    "labelTranslations": {
      "ar": "المؤشرات",
      "en": "Indicators"
