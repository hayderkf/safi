          "ar": "نسبة الإنجاز",
          "en": "Completion Rate"
        },
        "isRequired": true
      },
      {
        "id": "project_status",
        "type": "radioField",
        "labelTranslations": {
          "ar": "حالة المشروع",
          "en": "Project Status"
        },
        "isRequired": true,
        "options": [
          {
            "valueKey": "ongoing",
            "valueTranslations": {
              "ar": "جارٍ",
              "en": "Ongoing"
            }
          },
          {
            "valueKey": "stopped",
            "valueTranslations": {
              "ar": "متوقف",
              "en": "Stopped"
            }
          },
          {
            "valueKey": "completed",
            "valueTranslations": {
              "ar": "منجز",
              "en": "Completed"
            }
          }
        ]
      }
    ]
  },
  {
    "id": "step_recommendations",
    "type": "groupField",
    "layout": "step",
    "labelTranslations": {
      "ar": "التوصيات",
      "en": "Recommendations"
    },
    "subFields": [
      {
        "id": "general_evaluation",
        "type": "radioField",
        "labelTranslations": {
          "ar": "التقييم العام",
          "en": "General Evaluation"
        },
        "isRequired": true,
        "options": [
          {
            "valueKey": "weak",
            "valueTranslations": {
              "ar": "ضعيف",
              "en": "Weak"
