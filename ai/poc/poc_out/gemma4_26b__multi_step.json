          },
          {
            "valueKey": "medium",
            "valueTranslations": {
              "ar": "متوسط",
              "en": "Medium"
            }
          },
          {
            "valueKey": "good",
            "valueTranslations": {
              "ar": "جيد",
              "en": "Good"
            }
          },
          {
            "valueKey": "excellent",
            "valueTranslations": {
              "ar": "ممتاز",
              "en": "Excellent"
            }
          }
        ]
      },
      {
        "id": "notes",
        "type": "noteField",
        "labelTranslations": {
          "ar": "ملاحظات",
          "en": "Notes"
